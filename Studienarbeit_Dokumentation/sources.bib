@misc{carqueville_orbifolds_2020,
	title = {Orbifolds of Reshetikhin-Turaev {TQFTs}},
	url = {http://arxiv.org/abs/1809.01483},
	doi = {10.48550/arXiv.1809.01483},
	abstract = {We construct three classes of generalised orbifolds of Reshetikhin-Turaev theory for a modular tensor category \${\textbackslash}mathcal\{C\}\$, using the language of defect {TQFT} from [{arXiv}:1705.06085]: (i) spherical fusion categories give orbifolds for the "trivial" defect {TQFT} associated to vect, (ii) \$G\$-crossed extensions of \${\textbackslash}mathcal\{C\}\$ give group orbifolds for any finite group \$G\$, and (iii) we construct orbifolds from commutative \$Δ\$-separable symmetric Frobenius algebras in \${\textbackslash}mathcal\{C\}\$. We also explain how the Turaev-Viro state sum construction fits into our framework by proving that it is isomorphic to the orbifold of case (i). Moreover, we treat the cases (ii) and (iii) in the more general setting of ribbon tensor categories. For case (ii) we show how Morita equivalence leads to isomorphic orbifolds, and we discuss Tambara-Yamagami categories as particular examples.},
	number = {{arXiv}:1809.01483},
	publisher = {{arXiv}},
	author = {Carqueville, Nils and Runkel, Ingo and Schaumann, Gregor},
	urldate = {2026-07-09},
	date = {2020-04-27},
	eprinttype = {arxiv},
	eprint = {1809.01483 [math.QA]},
	keywords = {High Energy Physics - Theory, Mathematical Physics, Mathematics - Quantum Algebra},
	file = {Full Text PDF:C\:\\Users\\depelcda\\Zotero\\storage\\2U3W9Z2D\\Carqueville et al. - 2020 - Orbifolds of Reshetikhin-Turaev TQFTs.pdf:application/pdf;Snapshot:C\:\\Users\\depelcda\\Zotero\\storage\\U4PAJKRW\\1809.html:text/html},
